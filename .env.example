# human_ai_robot environment template.
# Copy to `.env` (which is git-ignored) and fill in. NEVER commit real keys.
# The software reads API keys ONLY from the environment, never from config files.

# --- Core runtime -------------------------------------------------------
# Keep simulation ON until a robot has been commissioned by qualified engineers.
ROBOT_SIMULATION_ONLY=true
# MUST stay false unless commissioning is complete.
ROBOT_MOTION_ENABLED_DEFAULT=false
ROBOT_LOG_LEVEL=INFO
ROBOT_JOINT_LIMITS_PATH=configuration/joint_limits/preliminary_limits.json

# --- Conversation -------------------------------------------------------
# one of: local | online | echo
ROBOT_CONVERSATION_PROVIDER=local
ROBOT_ONLINE_AI_ENABLED=false

# --- Speech / Vision ----------------------------------------------------
ROBOT_SPEECH_ENABLED=false
ROBOT_VISION_ENABLED=false

# --- Optional online AI provider keys (examples) ------------------------
# Any variable ending in _API_KEY is picked up automatically.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_SPEECH_API_KEY=
